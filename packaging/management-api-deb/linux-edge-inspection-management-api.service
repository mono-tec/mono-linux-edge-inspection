[Unit]
Description=Linux Edge Inspection Management API

# Inspection WorkerのUnix Domain Socketへ接続するため、
# Inspection Workerより後に起動します。
After=linux-edge-inspection-inspection-worker.service

# Inspection Workerを関連サービスとして起動対象に含めます。
Wants=linux-edge-inspection-inspection-worker.service


[Service]
Type=simple

# Linux Edge Inspection専用ユーザーで実行します。
User=linux-edge-inspection
Group=linux-edge-inspection

# appsettings.jsonを読み込むため、
# アプリケーション配置先を作業ディレクトリにします。
WorkingDirectory=/opt/linux-edge-inspection-management-api

# ASP.NET Coreの本番環境用設定を使用します。
Environment=ASPNETCORE_ENVIRONMENT=Production

# Linux上では8081番ポートで待ち受けます。
# 0.0.0.0を指定することで、localhostだけでなく
# 外部PCからもManagement APIへアクセス可能にします。
Environment=ASPNETCORE_URLS=http://0.0.0.0:8081

# Inspection Workerとの接続先Unix Domain Socketです。
Environment=InspectionWorkerClient__SocketPath=/run/linux-edge-inspection/inspection-worker.sock

# Runtimeが保存した撮像画像の参照先です。
Environment=CaptureImages__RootDirectory=/var/lib/linux-edge-inspection/captures

# Management APIを常駐プロセスとして実行します。
ExecStart=/usr/bin/linux-edge-inspection-management-api

# 異常終了した場合のみ再起動します。
Restart=on-failure

# 再起動前に5秒待機します。
RestartSec=5


[Install]
WantedBy=multi-user.target