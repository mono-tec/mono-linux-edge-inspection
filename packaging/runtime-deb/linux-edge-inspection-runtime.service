[Unit]
Description=Linux Edge Inspection Camera Runtime
After=multi-user.target

[Service]
Type=oneshot

# Linux Edge Inspection専用ユーザーで実行します。
User=linux-edge-inspection
Group=linux-edge-inspection

# カメラデバイスへアクセスするため、
# videoグループを補助グループとして追加します。
SupplementaryGroups=video

# /var/lib/linux-edge-inspection を
# systemdによって作成・管理します。
StateDirectory=linux-edge-inspection

# appsettings.jsonを読み込むため、
# アプリケーション配置先を作業ディレクトリにします。
WorkingDirectory=/opt/linux-edge-inspection-runtime

# 本番環境用の設定を使用します。
Environment=DOTNET_ENVIRONMENT=Production

# 撮影画像はLinux Edge Inspection共通データ領域へ保存します。
Environment=Camera__OutputDirectory=/var/lib/linux-edge-inspection/captures

# 1回の撮影Runtimeを実行します。
ExecStart=/usr/bin/linux-edge-inspection-runtime

# oneshot実行完了後もactive状態を保持します。
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target