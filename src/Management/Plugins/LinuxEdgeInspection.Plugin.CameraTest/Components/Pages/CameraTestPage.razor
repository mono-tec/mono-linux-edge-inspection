@page "/plugins/camera-test"
@inject ICameraTestService CameraTestService

<PageTitle>Camera Test | Linux Edge Inspection Platform</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">INSPECTION DIAGNOSTICS</p>
        <h1>Camera Test</h1>
        <p class="page-description">Run a test inspection and review each processing stage.</p>
    </div>
    <button class="button button-primary" @onclick="RunTestAsync" disabled="@_isRunning">
        @(_isRunning ? "Running..." : "Run Camera Test")
    </button>
</div>

@if (_result is null)
{
    <div class="empty-state">Select <strong>Run Camera Test</strong> to execute one inspection.</div>
}
else
{
    <div class="result-grid">
        <ResultItem Name="Capture" Value="@_result.Capture" />
        <ResultItem Name="Preprocess" Value="@_result.Preprocess" />
        <ResultItem Name="Analysis" Value="@_result.Analysis" />
        <ResultItem Name="Judgement" Value="@_result.Judgement" Highlight="true" />
        <ResultItem Name="Label" Value="@_result.Label" />
        <ResultItem Name="Error" Value="@(_result.Error ?? "None")" />
    </div>

    <div class="table-shell">
        <table class="data-table">
            <thead>
                <tr>
                    <th>CaptureIndex</th>
                    <th>FilePath</th>
                    <th>View</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var capture in _result.Captures)
                {
                    <tr>
                        <td>@capture.CaptureIndex</td>
                        <td>@(capture.FilePath ?? "None")</td>
                        <td>
                            @if (capture.ViewUrl is not null)
                            {
                                <a href="@capture.ViewUrl" target="_blank" rel="noopener noreferrer">Open image</a>
                            }
                            else
                            {
                                <span>Unavailable</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private CameraTestResult? _result;
    private bool _isRunning;

    private async Task RunTestAsync()
    {
        _isRunning = true;

        try
        {
            _result = await CameraTestService.RunAsync();
        }
        catch (Exception exception)
        {
            _result = new CameraTestResult(
                RequestId: string.Empty,
                Captures: [],
                Capture: "Failed",
                Preprocess: "Not Executed",
                Analysis: "Not Executed",
                Judgement: "Unknown",
                Label: null,
                Error: exception.Message);
        }
        finally
        {
            _isRunning = false;
        }
    }
}
