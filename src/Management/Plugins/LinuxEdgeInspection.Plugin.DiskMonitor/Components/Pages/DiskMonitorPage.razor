@page "/plugins/disk-monitor"
@inject IDiskInfoService DiskInfoService

<PageTitle>Disk Monitor | Linux Edge Inspection Platform</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">SYSTEM STORAGE</p>
        <h1>Disk Monitor</h1>
        <p class="page-description">Local disk capacity and usage for this edge device.</p>
    </div>
    <button class="button button-secondary" @onclick="Refresh">Refresh</button>
</div>

@if (_disks.Count == 0)
{
    <div class="empty-state">No disk information is available.</div>
}
else
{
    <div class="table-shell">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Drive</th>
                    <th>Total</th>
                    <th>Free</th>
                    <th>Used</th>
                    <th>Usage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var disk in _disks)
                {
                    <tr>
                        <td class="primary-cell">@disk.Name</td>
                        <td>@FormatSize(disk.TotalSize)</td>
                        <td>@FormatSize(disk.FreeSpace)</td>
                        <td>@FormatSize(disk.UsedSize)</td>
                        <td class="usage-cell">
                            <div class="progress-track" aria-label="@($"Disk usage {disk.UsedPercent:0.0}%")">
                                <div class="progress-value @GetProgressClass(disk.UsedPercent)"
                                     style="width:@($"{disk.UsedPercent:0.0}%")"></div>
                            </div>
                            <span>@disk.UsedPercent.ToString("0.0")%</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<DiskInfo> _disks = [];

    protected override void OnInitialized() => Refresh();

    private void Refresh() => _disks = DiskInfoService.GetDisks();

    private static string FormatSize(long bytes) => $"{bytes / 1024d / 1024d / 1024d:0.0} GB";

    private static string GetProgressClass(double usedPercent) => usedPercent switch
    {
        >= 90 => "progress-danger",
        >= 70 => "progress-warning",
        _ => "progress-normal"
    };
}
