{
  "ManagementApi": {
    "BaseUrl": "http://127.0.0.1:8081/"
  },
  "CameraTest": {
    "UseDummyService": false
  },
  "LogViewer": {
    "Journalctl": {
      "ExecutablePath": "/usr/bin/journalctl",
      "TimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
