{
  "Urls": "http://127.0.0.1:8081",
  "InspectionWorkerClient": {
    "SocketPath": "/run/linux-edge-inspection/inspection-worker.sock",
    "TimeoutSeconds": 60
  },
  "CaptureImages": {
    "RootDirectory": "/var/lib/linux-edge-inspection-runtime/captures"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
