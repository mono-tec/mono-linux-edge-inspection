{
  "CaptureRequestEndpoint": {
    "SocketPath": "/run/linux-edge-inspection/capture-request-listener.sock",
    "Backlog": 16
  },
  "CaptureRuntimeLauncher": {
    "SystemctlPath": "/usr/bin/systemctl",
    "ServiceName": "linux-edge-inspection-runtime.service",
    "TimeoutSeconds": 30,
    "ResultFilePath": "/var/lib/linux-edge-inspection-runtime/capture-result.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}